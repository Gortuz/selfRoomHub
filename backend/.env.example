# Token estático para la API (Authorization: Bearer <token>)
SELFROOMHUB_TOKEN=cambia-esto

# Ruta al YAML de dispositivos (por defecto: <repo>/config/devices.yaml)
# SELFROOMHUB_CONFIG=

# Credenciales locales de Tuya, referenciadas en devices.yaml con ${VAR}
TUYA_PARLANTES_ID=
TUYA_PARLANTES_KEY=

# Avisos de batería del servidor (ntfy). Sin topic, los avisos externos quedan desactivados.
# Nombre largo y aleatorio: en ntfy.sh cualquiera que lo conozca puede leer los avisos
# SELFROOMHUB_NTFY_TOPIC=
# Servidor ntfy (por defecto https://ntfy.sh)
# SELFROOMHUB_NTFY_URL=
# Token de acceso si el topic está protegido (opcional)
# SELFROOMHUB_NTFY_TOKEN=
# Avisa "conecta el cargador" al bajar a este % sin cargar (por defecto 25)
# SELFROOMHUB_BATTERY_LOW=25
# Avisa "desconecta el cargador" al llegar a este % cargando (por defecto 80)
# SELFROOMHUB_BATTERY_HIGH=80
# Aviso urgente, repetido cada 15 min, a este % sin cargar (por defecto 15)
# SELFROOMHUB_BATTERY_CRITICAL=15

# Spotify (opcional, ver docs/spotify.md). Sin client id los endpoints responden 409.
# SELFROOMHUB_SPOTIFY_CLIENT_ID=
# Debe coincidir con el Redirect URI de la app en developer.spotify.com (loopback 127.0.0.1 o https)
# SELFROOMHUB_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
# Nombre del dispositivo Spotify Connect donde reproducir (sin mayúsculas/acentos).
# Vacío: dispositivo activo o el primer Smartphone
# SELFROOMHUB_SPOTIFY_DEVICE=
# Dónde se guardan los tokens (permisos 600)
# SELFROOMHUB_SPOTIFY_TOKEN_FILE=~/.local/state/selfroomhub/spotify.json
